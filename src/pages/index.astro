---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModTip from '../components/ModTip.astro';
import Mentions from '../components/Mentions.astro';
import Series from '../components/Series.astro';
import { url, compact, full } from '../lib/util';

const all = (await getCollection('mods')).sort((a, b) => a.data.order - b.data.order);

/* Only authored work counts as portfolio. Projects efkrdnzz helped on are
   listed separately and never fold into the headline numbers. */
const own = all.filter((m) => m.data.role === 'author');
const mentions = all.filter((m) => m.data.role !== 'author');

/* Headline numbers count shipped work only. An unreleased mod has a page and a
   wiki, but it is not yet a project on the shelf and must not inflate a total
   the whole site is sorted by. It reaches readers through the series section. */
const shipped = own.filter((m) => m.data.status === 'released');

const featured = shipped.find((m) => m.data.featured) ?? shipped[0];
const rest = shipped.filter((m) => m.id !== featured.id);

/* Counts both platforms, but only work efkrdnzz actually authored. */
const totalDownloads = shipped.reduce(
  (n, m) => n + (m.data.downloads ?? 0) + (m.data.modrinthDownloads ?? 0),
  0
);
const platforms = shipped.some((m) => m.data.modrinth)
  ? ['CurseForge', 'Modrinth']
  : ['CurseForge'];
const modCount = shipped.filter((m) => m.data.kind === 'mod').length;
const packCount = shipped.filter((m) => m.data.kind === 'modpack').length;

/* Series modules that have a real page here. Passing this in keeps the
   series data free of routes, and stops an unpublished module from
   rendering as a link to nothing. */
const seriesLinks = Object.fromEntries(
  own
    .filter((m) => m.data.series === 'Minefinity Series')
    .map((m) => [
      m.id,
      {
        href: url(`/mods/${m.id}`),
        wiki: m.data.hasCodex
          ? url(`/mods/${m.id}/codex`)
          : m.data.hasManual
            ? url(`/mods/${m.id}/manual`)
            : undefined,
      },
    ])
);
---

<Base
  title="efkrdnzz — Minecraft mods"
  description="Minecraft mod developer. Eight projects on CurseForge and Modrinth built around abilities, progression and boss fights, including Solo Leveling: Reawakening and the Minefinity Series."
>
  <section class="shell hero">
    <div class="hero__copy">
      <p class="eyebrow enter enter--1">Minecraft mod developer</p>
      <h1 class="display hero__name enter enter--2">efkrdnzz</h1>
      <hr class="hero__rule enter enter--2" />
      <p class="lede enter enter--3">
        Eight projects on CurseForge, built around abilities, progression and the
        fights that test them. Solo Leveling: Reawakening is the big one; the
        <a href="#series">Minefinity Series</a> is the one still growing.
      </p>
      <div class="actions enter enter--4">
        <a class="btn btn--primary" href={url('/mods')}>
          Browse the mods <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn" href={url(`/mods/${featured.id}`)}>
          {featured.data.short}
        </a>
      </div>
    </div>

    <div class="enter enter--5">
      <ModTip mod={featured} feature />
    </div>
  </section>

  <section class="shell">
    <div class="rail">
      <div class="rail__cell">
        <span class="rail__k">Total downloads</span>
        <span class="rail__v" title={`${full(totalDownloads)} downloads`}>
          {compact(totalDownloads)}
        </span>
      </div>
      <div class="rail__cell">
        <span class="rail__k">Projects</span>
        <span class="rail__v">{shipped.length}</span>
      </div>
      <div class="rail__cell">
        <span class="rail__k">Mods &middot; Packs</span>
        <span class="rail__v">{modCount} <small>/</small> {packCount}</span>
      </div>
      <div class="rail__cell">
        <span class="rail__k">Published on</span>
        <span class="rail__v" style="font-size:0.95rem;">{platforms.join(' · ')}</span>
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section__head reveal">
      <div class="section__title">
        <p class="eyebrow">Everything else</p>
        <h2 class="h2">The rest of the shelf</h2>
      </div>
      <p class="mono-note">Ordered by downloads</p>
    </div>

    <div class="grid">
      {rest.map((mod) => (
        <div class="reveal">
          <ModTip mod={mod} />
        </div>
      ))}
    </div>
  </section>

  <Series published={seriesLinks} />

  <Mentions items={mentions} />
</Base>
