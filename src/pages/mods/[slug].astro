---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, full } from '../../lib/util';

export async function getStaticPaths() {
  const mods = await getCollection('mods');
  /* Projects efkrdnzz only helped on do not get a hub page here — they are
     listed as honorable mentions and link out to their actual authors. */
  return mods
    .filter((mod) => mod.data.role === 'author')
    .map((mod) => ({ params: { slug: mod.id }, props: { mod } }));
}

const { mod } = Astro.props;
const d = mod.data;

const isHud = d.theme === 'slr';
const panelLabel = isHud ? 'System' : 'Project data';
const totalDownloads = d.downloads + (d.modrinthDownloads ?? 0);
const platforms = d.modrinth ? 'CurseForge and Modrinth' : 'CurseForge';
---

<Base title={`${d.title} — efkrdnzz`} description={d.blurb} mod={d.theme}>
  <div class="mod-page">
    <nav class="subnav" aria-label={`${d.short} sections`}>
      <div class="shell subnav__in">
        <a class="subnav__link" href={url(`/mods/${mod.id}`)} aria-current="page">Overview</a>
        <span class="subnav__soon">Guide</span>
        <span class="subnav__soon">Changelog</span>
        <a class="subnav__link" href="#download">Download</a>
        <a class="subnav__link" href={url('/mods')} style="margin-left:auto;">&larr; All mods</a>
      </div>
    </nav>

    <section class="shell mod-hero">
      <div class="mod-hero__copy">
        <p class="eyebrow">{d.kind} &middot; {d.categories.join(' · ')}</p>
        <h1 class="mod-title">{d.title}</h1>
        <p class="mod-tagline">{d.tagline}</p>
        <p class="lede">{d.blurb}</p>

        <div class="actions">
          <a
            class="btn btn--primary"
            href={d.curseforge}
            rel="noopener noreferrer"
            target="_blank"
          >
            Get it on CurseForge <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          {d.modrinth && (
            <a class="btn" href={d.modrinth} rel="noopener noreferrer" target="_blank">
              Modrinth
            </a>
          )}
        </div>
      </div>

      <aside class="sys" aria-label="Project data">
        <div class="sys__label">{panelLabel}</div>

        <div class="sys__rows">
          <div class="sys__row">
            <span class="sys__k">Status</span>
            <span class="sys__v sys__v--hot">Published</span>
          </div>
          <div class="sys__row">
            <span class="sys__k">Type</span>
            <span class="sys__v">{d.kind}</span>
          </div>
          <div class="sys__row">
            <span class="sys__k">CurseForge</span>
            <span class="sys__v">{full(d.downloads)}</span>
          </div>
          <div class="sys__row">
            <span class="sys__k">Category</span>
            <span class="sys__v">{d.categories.join(', ')}</span>
          </div>
          <div class="sys__row">
            <span class="sys__k">Author</span>
            <span class="sys__v">{d.author}</span>
          </div>
          {d.loaders.length > 0 && (
            <div class="sys__row">
              <span class="sys__k">Loader</span>
              <span class="sys__v">{d.loaders.join(', ')}</span>
            </div>
          )}
          {d.mcVersions.length > 0 && (
            <div class="sys__row">
              <span class="sys__k">Minecraft</span>
              <span class="sys__v">{d.mcVersions.join(', ')}</span>
            </div>
          )}
          {d.modrinthDownloads !== undefined && (
            <div class="sys__row">
              <span class="sys__k">Modrinth</span>
              <span class="sys__v">{full(d.modrinthDownloads)}</span>
            </div>
          )}
        </div>

        <div class="sys__foot">
          <span>{isHud ? 'awaiting guide data' : 'guide not written yet'}</span>
          <span class="sys__caret" aria-hidden="true"></span>
        </div>
      </aside>
    </section>

    {d.features.length > 0 && (
      <section class="shell section" style="padding-top:0;">
        <div class="section__head reveal">
          <div class="section__title">
            <p class="eyebrow">What it adds</p>
            <h2 class="h2">Systems</h2>
          </div>
        </div>

        <div class="feats reveal">
          {d.features.map((f) => (
            <div class="feat">
              <span class="feat__k">{f.k}</span>
              <span class="feat__t">{f.t}</span>
              <p class="feat__d">{f.d}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="shell section" style="padding-top:var(--s6);">
      <div class="pending reveal">
        <span class="pending__mark" aria-hidden="true">!</span>
        <div class="pending__body">
          <span class="pending__t">Guide in progress</span>
          <p class="pending__d">
            The wiki for {d.short} is not written yet. When it lands it will live at
            <code>/mods/{mod.id}/guide</code>, with the changelog and a version table
            alongside it.
          </p>
        </div>
      </div>
    </section>

    <section class="shell section" id="download" style="padding-top:0;">
      <div class="dl reveal">
        <div class="dl__copy">
          <p class="eyebrow">Download</p>
          <h2 class="h3">{d.title}</h2>
          <p class="mono-note">
            {full(totalDownloads)} downloads on {platforms}
            {d.mcVersions.length > 0 && ` · ${d.mcVersions.join(', ')}`}
            {d.loaders.length > 0 && ` · ${d.loaders.join(', ')}`}
          </p>
        </div>

        <div class="actions">
          <a
            class="btn btn--primary"
            href={d.curseforge}
            rel="noopener noreferrer"
            target="_blank"
          >
            CurseForge <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          {d.modrinth && (
            <a class="btn" href={d.modrinth} rel="noopener noreferrer" target="_blank">
              Modrinth
            </a>
          )}
        </div>
      </div>
    </section>
  </div>
</Base>
