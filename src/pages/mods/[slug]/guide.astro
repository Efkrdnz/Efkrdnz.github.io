---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { url } from '../../../lib/util';
import '../../../styles/vault.css';

import artClasses from '../../../assets/wiki/classes.png';
import artLeveling from '../../../assets/wiki/leveling.png';
import artDungeon from '../../../assets/wiki/dungeon.png';
import artBosses from '../../../assets/wiki/bosses.png';
import artSystem from '../../../assets/wiki/system.png';
import artShadow from '../../../assets/wiki/shadowmonarch.png';
import artFrost from '../../../assets/wiki/frostmonarch.png';

export async function getStaticPaths() {
  const mods = await getCollection('mods');
  return mods
    .filter((m) => m.data.hasGuide)
    .map((mod) => ({ params: { slug: mod.id }, props: { mod } }));
}

const { mod } = Astro.props;
const d = mod.data;

const wikis = import.meta.glob<{ default: { nodes: any[] } }>(
  '../../../data/wiki/*.json',
  { eager: true }
);
const dataEntry = Object.entries(wikis).find(([p]) => p.endsWith(`/${mod.id}.json`));
const nodes: any[] = dataEntry ? (dataEntry[1].default.nodes ?? []) : [];
const known = new Set(nodes.map((n) => n.id));

const guides = import.meta.glob<{ default: any }>(
  '../../../data/wiki/*.guide.json',
  { eager: true }
);
const guideEntry = Object.entries(guides).find(([p]) => p.endsWith(`/${mod.id}.guide.json`));
const guide = guideEntry ? guideEntry[1].default : null;

/* Screenshots are convention over configuration: any image dropped into
   assets/wiki/shots named after a node id or a step id is picked up here and
   rendered in that node's panel or that step's header. */
const shotFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/wiki/shots/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

const shots: Record<string, { src: string; w: number; h: number }> = {};
for (const [path, m] of Object.entries(shotFiles)) {
  const id = path.split('/').pop()!.replace(/\.(png|jpe?g|webp)$/i, '');
  const optimized = await getImage({ src: m.default, width: 880, format: 'webp' });
  shots[id] = {
    src: optimized.src,
    w: optimized.attributes.width ?? 880,
    h: optimized.attributes.height ?? 495,
  };
}

/* Art per chapter. Keyed by step id so adding a chapter without art is fine. */
const CHAPTER_ART: Record<string, any> = {
  'step-evaluator': artClasses,
  'step-your-kit': artSystem,
  'step-first-gates': artDungeon,
  'step-levelling': artLeveling,
  'step-cartenon': artSystem,
  'step-job-change': artShadow,
  'step-dkc': artBosses,
  'step-endgame': artFrost,
};

/* Server-side wikilink rendering: the guide is crawlable and works with
   JavaScript off, where links fall back to plain emphasised text. */
function esc(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function inline(s: string): string {
  return esc(s)
    .replace(/\[\[([a-z0-9-]+)\|([^\]]+)\]\]/g, (_m, id: string, label: string) =>
      known.has(id)
        ? `<button type="button" class="vlink" data-goto="${id}">${label}</button>`
        : `<em>${label}</em>`
    )
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/`(.+?)`/g, '<code>$1</code>');
}

function prose(body: string): string {
  return body
    .split(/\n{2,}/)
    .map((p) => `<p>${inline(p.trim())}</p>`)
    .join('');
}

const chapters: any[] = guide?.chapters ?? [];
const phases: { name: string; items: any[] }[] = [];
chapters.forEach((c) => {
  const last = phases[phases.length - 1];
  if (last && last.name === c.phase) last.items.push(c);
  else phases.push({ name: c.phase, items: [c] });
});

const GROUP_ORDER = [
  'system', 'evaluation', 'rank', 'class', 'style', 'skill',
  'vessel', 'shadow', 'dungeon', 'boss', 'item', 'setting',
];
const GROUP_LABEL: Record<string, string> = {
  system: 'The System', evaluation: 'Evaluation', rank: 'Hunter ranks',
  class: 'Classes', style: 'Styles', skill: 'Skills', vessel: 'Vessels',
  shadow: 'Shadows', dungeon: 'Dungeons & gates', boss: 'Bosses',
  item: 'Items & gear', setting: 'Settings & tools',
};

const grouped = GROUP_ORDER
  .map((key) => ({
    key,
    label: GROUP_LABEL[key] ?? key,
    items: nodes.filter((n) => n.category === key),
  }))
  .filter((g) => g.items.length > 0);

const other = nodes.filter((n) => !GROUP_ORDER.includes(n.category));
if (other.length) grouped.push({ key: 'other', label: 'Other', items: other });
---

<Base
  title={`${d.short} Wiki — efkrdnzz`}
  description={`A guide and interactive map for ${d.title}: what to do first, then next, with every class, style, vessel, gate and boss connected.`}
  mod={d.theme}
  bare
>
  <div class="vault" data-vault>
    <div class="vbar">
      <a class="vbar__brand" href={url(`/mods/${mod.id}`)}>{d.short} Vault</a>

      <div class="vbar__search">
        <input type="search" placeholder="Search the vault…" aria-label="Search the vault" />
      </div>

      <div class="vbar__spacer"></div>

      <div class="vseg" role="group" aria-label="View mode">
        <button type="button" data-view="guide" aria-pressed="true">Guide</button>
        <button type="button" data-view="graph" aria-pressed="false">Map</button>
        <button type="button" data-view="index" aria-pressed="false">Index</button>
      </div>

      <a class="vbtn" href={url(`/mods/${mod.id}/install`)}>Install</a>
      <button type="button" class="vbtn" data-reset>Reset</button>
    </div>

    <div class="vstage">
      <svg class="vstage__svg" role="application" aria-label={`${d.short} wiki map. Use the Guide or Index view for a readable version.`}>
        <g class="g-root">
          <g class="g-links"></g>
          <g class="g-nodes"></g>
          {/* Sits above the nodes and inside the pan/zoom group, so the lock
              travels with the graph rather than floating over it. */}
          <g class="g-reticle" aria-hidden="true"></g>
        </g>
      </svg>

      {/* System chrome. Decorative except the readout, which is live data and
          is still hidden from the accessibility tree — the Index view is the
          readable equivalent of everything the map shows. */}
      <div class="vscan" aria-hidden="true"></div>
      <div class="vframe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

      <div class="vtel" aria-hidden="true">
        <p class="vtel__h">System</p>
        <div class="vtel__rows">
          <span class="vtel__k">Nodes</span><span class="vtel__v" data-tel="nodes">—</span>
          <span class="vtel__k">Depth</span><span class="vtel__v" data-tel="depth">—</span>
          <span class="vtel__k">Zoom</span><span class="vtel__v" data-tel="zoom">—</span>
          <span class="vtel__k">Target</span><span class="vtel__v vtel__v--hot" data-tel="target">—</span>
        </div>
      </div>

      <div class="vlegend" aria-hidden="true">
        <div class="vlegend__h">How to read this</div>
        <div class="vlegend__ramp">
          <i style="background:#A6E9FF"></i>
          <i style="background:#3FC6FF"></i>
          <i style="background:#2C90C4"></i>
          <i style="background:#1E6B94"></i>
        </div>
        <div class="vlegend__scale"><span>broad</span><span>specific</span></div>
        <div class="vlegend__row">
          <svg width="16" height="16" viewBox="-8 -8 16 16"><path d="M0,-7L6.06,-3.5L6.06,3.5L0,7L-6.06,3.5L-6.06,-3.5Z" fill="#3FC6FF"/></svg>
          <span>opens further</span>
        </div>
        <div class="vlegend__row">
          <svg width="16" height="16" viewBox="-8 -8 16 16"><path d="M0,-5L4.33,-2.5L4.33,2.5L0,5L-4.33,2.5L-4.33,-2.5Z" fill="#060A16" stroke="#2C90C4" stroke-width="1.6"/></svg>
          <span>final page</span>
        </div>
      </div>

      <div class="vhint">
        <b>Click</b> a node to open it &middot; <b>drag</b> to move &middot; <b>scroll</b> to zoom
      </div>

      <aside class="vpanel" role="dialog" aria-label="Page details" aria-hidden="true">
        <div class="vpanel__head">
          <div class="vpanel__eyebrow"></div>
          <h2 class="vpanel__title"></h2>
          <p class="vpanel__tag"></p>
          <button type="button" class="vpanel__close" aria-label="Close panel">&#10005;</button>
        </div>
        <div class="vpanel__body"></div>
      </aside>

      {guide && (
        <div class="vguide is-open">
          <div class="vguide__in">
            <header class="vguide__head">
              <p class="vguide__eyebrow">{d.title}</p>
              <h1 class="vguide__title">{guide.intro.title}</h1>
              <div class="vguide__lead" set:html={prose(guide.intro.body)} />
            </header>

            <nav class="vtoc" aria-label="Guide steps">
              {chapters.map((c: any) => (
                <a class="vtoc__item" href={`#${c.id}`}>
                  <span class="vtoc__n">{String(c.n).padStart(2, '0')}</span>
                  <span class="vtoc__t">{c.title}</span>
                </a>
              ))}
            </nav>

            {phases.map((ph) => (
              <section class="vphase">
                <h2 class="vphase__h">{ph.name}</h2>

                {ph.items.map((c: any) => (
                  <article class="vstep" id={c.id}>
                    <div class="vstep__rail">
                      <span class="vstep__n">{String(c.n).padStart(2, '0')}</span>
                    </div>

                    <div class="vstep__body">
                      <h3 class="vstep__t">{c.title}</h3>
                      <p class="vstep__goal">{c.goal}</p>
                      {c.gate && <p class="vstep__gate">{c.gate}</p>}

                      {shots[c.id] ? (
                        <img
                          class="vstep__art"
                          src={shots[c.id].src}
                          width={shots[c.id].w}
                          height={shots[c.id].h}
                          alt={`${c.title} in game`}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : CHAPTER_ART[c.id] && (
                        <Image
                          class="vstep__art"
                          src={CHAPTER_ART[c.id]}
                          alt=""
                          widths={[420, 760]}
                          sizes="(max-width: 700px) 100vw, 640px"
                          loading="lazy"
                          densities={undefined}
                        />
                      )}

                      <div class="vstep__prose" set:html={prose(c.body)} />

                      {c.checklist?.length > 0 && (
                        <ul class="vcheck">
                          {c.checklist.map((li: string) => (
                            <li set:html={inline(li)} />
                          ))}
                        </ul>
                      )}

                      {c.nodes?.length > 0 && (
                        <div class="vchips vchips--guide">
                          {c.nodes
                            .filter((id: string) => known.has(id))
                            .map((id: string) => (
                              <button type="button" class="vchip" data-goto={id}>
                                {nodes.find((n) => n.id === id)?.title ?? id}
                              </button>
                            ))}
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </section>
            ))}

            <footer class="vguide__foot">
              <p>
                That is the spine of it. Everything else &mdash; every class, style, vessel,
                gate, boss and item &mdash; is on the <button type="button" class="vlink" data-view-jump="graph">map</button>,
                or listed in the <button type="button" class="vlink" data-view-jump="index">index</button>.
              </p>
            </footer>
          </div>
        </div>
      )}

      <div class="vindex">
        <div class="vindex__in">
          <p class="vindex__lead">
            Every page in the vault, grouped. {nodes.length} entries &mdash; pick one to open it
            on the map.
          </p>

          {grouped.map((g) => (
            <section class="vgroup">
              <h2 class="vgroup__h">{g.label} &middot; {g.items.length}</h2>
              <div class="vlist">
                {g.items.map((n: any) => (
                  <button type="button" class="vitem" data-goto={n.id}>
                    <span class="vitem__t">{n.title}</span>
                    <span class="vitem__d">{n.tagline}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>

    <script type="application/json" id="vault-data" set:html={JSON.stringify(nodes)} is:inline></script>
    <script type="application/json" id="vault-shots" set:html={JSON.stringify(shots)} is:inline></script>
  </div>

  <script>
    import { initVault } from '../../../scripts/vault';
    initVault();
  </script>
</Base>
