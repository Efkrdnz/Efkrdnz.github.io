---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ModTip from '../../components/ModTip.astro';
import Mentions from '../../components/Mentions.astro';
import { full } from '../../lib/util';

const all = (await getCollection('mods')).sort((a, b) => a.data.order - b.data.order);

const own = all.filter((m) => m.data.role === 'author');
const mentions = all.filter((m) => m.data.role !== 'author');

/* The shelf is graded by downloads, so it holds shipped work. Anything still
   in development gets its own section below rather than a rarity colour it
   has not earned. */
const shipped = own.filter((m) => m.data.status === 'released');
const building = own.filter((m) => m.data.status !== 'released');

const mods = shipped.filter((m) => m.data.kind === 'mod');
const packs = shipped.filter((m) => m.data.kind === 'modpack');
const totalDownloads = shipped.reduce(
  (n, m) => n + (m.data.downloads ?? 0) + (m.data.modrinthDownloads ?? 0),
  0
);
---

<Base
  title="Mods — efkrdnzz"
  description="Every Minecraft mod and modpack by efkrdnzz, ordered by downloads."
>
  <section class="shell section">
    <div class="section__head">
      <div class="section__title">
        <p class="eyebrow">{shipped.length} projects</p>
        <h1 class="h2">Mods &amp; modpacks</h1>
      </div>
      <p class="mono-note">{full(totalDownloads)} downloads total</p>
    </div>

    <p class="lede">
      Rarity colour follows download count, so the shelf reads at a glance.
      Every project links out to its CurseForge page.
    </p>
  </section>

  <section class="shell" style="padding-bottom:var(--s8);">
    <div class="section__head reveal">
      <div class="section__title">
        <p class="eyebrow">Mods</p>
        <h2 class="h2">{mods.length} mods</h2>
      </div>
    </div>

    <div class="grid">
      {mods.map((mod) => (
        <div class="reveal">
          <ModTip mod={mod} />
        </div>
      ))}
    </div>
  </section>

  <section class="shell" style="padding-bottom:var(--s8);">
    <div class="section__head reveal">
      <div class="section__title">
        <p class="eyebrow">Modpacks</p>
        <h2 class="h2">{packs.length} {packs.length === 1 ? 'pack' : 'packs'}</h2>
      </div>
    </div>

    <div class="grid">
      {packs.map((mod) => (
        <div class="reveal">
          <ModTip mod={mod} />
        </div>
      ))}
    </div>
  </section>

  {building.length > 0 && (
    <section class="shell" style="padding-bottom:var(--s8);">
      <div class="section__head reveal">
        <div class="section__title">
          <p class="eyebrow">Not out yet</p>
          <h2 class="h2">{building.length} in development</h2>
        </div>
        <p class="mono-note">No download, but the wiki is written</p>
      </div>

      <div class="grid">
        {building.map((mod) => (
          <div class="reveal">
            <ModTip mod={mod} />
          </div>
        ))}
      </div>
    </section>
  )}

  <Mentions items={mentions} />
</Base>
